package hellocucumber;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.JavascriptExecutor;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;
import java.time.Duration;


public class MoodleLogin {
    private WebDriver driver;
    private WebDriverWait wait;

    public MoodleLogin(WebDriver driver, WebDriverWait wait) {
        this.driver = driver;
        this.wait = wait;
    }

    public void navigateToLoginPage() throws InterruptedException {
        // Navigate to the OpenCart website
        driver.get("http://localhost/");
        // Click on My Account, Login, and Register
        WebElement navigatetoLogin = driver.findElement(By.xpath("/html[1]/body[1]"));
        navigatetoLogin.click();
        //wait to be sure that the elemnt will show on the screen
        Thread.sleep(1000);

    }

    public void LoginUser(Teacher teacher) throws InterruptedException {
        // Fill in registration details
        WebElement usernameElement = driver.findElement(By.xpath("//input[@id='username']"));
        usernameElement.sendKeys(teacher.get_username);
        WebElement passwordElement = driver.findElement(By.xpath('//input[@id="password"]'));
        passwordElement.sendKeys(teacher.get_password);
        WebElement press_login = driver.findElement(By.xpath('//button[@id="loginbtn"]'));
        navigatetoLogin.click();
        Thread.sleep(1000);
        // Scroll down to the "Agree" checkbox
        ((JavascriptExecutor) driver).executeScript("window.scrollTo(0, document.body.scrollHeight);");

        // Wait for a moment
        try {
            Thread.sleep(500);
        } catch (InterruptedException e) {
            e.printStackTrace();
        }

    }

}
